  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "new_password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "new_password"
        ]
      },
      "VideoStatusDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "public_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "error",
              "cancelled"
            ]
          },
          "duration": {
            "type": "number",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "error_code": {
            "type": "string",
            "nullable": true
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "public_id",
          "title",
          "status",
          "duration",
          "metadata",
          "error_code",
          "expires_at"
        ]
      },
      "UploadSessionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "public_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "error",
              "cancelled"
            ]
          },
          "duration": {
            "type": "number",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "error_code": {
            "type": "string",
            "nullable": true
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "part_size": {
            "type": "number",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "maximum": 160
          }
        },
        "required": [
          "id",
          "public_id",
          "title",
          "status",
          "duration",
          "metadata",
          "error_code",
          "expires_at",
          "part_size",
          "part_count"
        ]
      },
      "PartUrlDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Presigned storage URL; do not log or rewrite its host"
          },
          "expires_in": {
            "type": "number",
            "example": 900
          }
        },
        "required": [
          "url",
          "expires_in"
        ]
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "duration": {
            "type": "number"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "stream_url": {
            "type": "string"
          },
          "download_url": {
            "type": "string"
          },
          "thumbnail_url": {
            "type": "string"
          }
        },
        "required": [
          "public_id",
          "title",
          "duration",
          "metadata",
          "stream_url",
          "download_url",
          "thumbnail_url"
        ]
      },
      "StartUploadDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "pattern": "\\S"
          },
          "size": {
            "type": "number",
            "minimum": 1,
            "maximum": 10737418240
          },
          "content_type": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/webm",
              "video/quicktime",
              "video/x-matroska"
            ]
          }
        },
        "required": [
          "title",
          "size",
          "content_type"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}
